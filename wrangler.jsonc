{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volunteer-compute-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGRAm-7JByD-t18O"
  },
  "routes": [
    {
      "pattern": "volunteer.apishelf.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volunteer-broker",
      "database_id": "85a5132d-a9ad-40e3-b13c-b7ce25055ef0",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "da3568a541de4cb795d57ccff8312324"
    }
  ],
  "containers": [
    {
      "class_name": "TestRunner",
      "scheduling_policy": "durable_object"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BROKER",
        "class_name": "BrokerObject"
      },
      {
        "name": "TEST_RUNNER",
        "class_name": "TestRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BrokerObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TestRunner"]
    }
  ]
}
