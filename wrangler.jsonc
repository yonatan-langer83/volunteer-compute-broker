{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "volunteer-compute-broker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "volunteer.apishelf.dev",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "volunteer-broker",
      "database_id": "85a5132d-a9ad-40e3-b13c-b7ce25055ef0",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BROKER",
        "class_name": "BrokerObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["BrokerObject"]
    }
  ]
}
